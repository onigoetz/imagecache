{
  "name": "onigoetz/imagecache",
  "description": "Image manipulation & caching for everybody",
  "keywords": ["laravel", "slim", "image", "automatic generation", "retina" ],
  "license": "MIT",
  "authors": [
    {
      "name": "Stéphane Goetz",
      "email": "onigoetz@onigoetz.ch"
    }
  ],
  "require": {
    "php": ">=8.1",
    "guzzlehttp/psr7": "^2.7",
    "intervention/image": "^3.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11 || ^12 || ^13",
    "mockery/mockery": "^1.6.2",
    "mikey179/vfsstream": "^1.6.1",
    "slim/slim": "^4",
    "orchestra/testbench": "^10 || ^11",
    "travail/image-perceptualhash": "^0.1.0",
    "php-di/slim-bridge": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "Onigoetz\\Imagecache\\": "src/"
      
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Onigoetz\\ImagecacheTests\\": "tests/",
      "Onigoetz\\ImagecacheUtils\\": "test-utils/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-clover=coverage.xml --log-junit=test-report.xml",
    "test:coverage-html": "phpunit --coverage-html=build/coverage"
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Onigoetz\\Imagecache\\Support\\Laravel\\ImagecacheServiceProvider"
      ]
    }
  }
}
